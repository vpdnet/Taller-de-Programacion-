{ Realice un programa para que un robot junte todas las flores de la 
avenida 1 y las deposite al final de dicha avenida. Al finalizar, debe 
informar la cantidad de flores depositadas y la cantidad de esquinas 
sin flores que encontró durante el recorrido}

programa ej1p1
procesos
  proceso juntarFlores(ES flores:numero;ES cantvacias:numero)
  comenzar
    si HayFlorEnLaEsquina
      mientras HayFlorEnLaEsquina
        tomarFlor 
        flores:= flores+1
    sino 
      cantvacias:= cantvacias+1
  fin
  
  proceso recorrerAvenida(E numAv: numero)
  variables
    flores,cantvacias:numero
  comenzar
    flores:= 0
    cantvacias:= 0
    Pos(numAv, 1)
    repetir 99
      juntarFlores(flores,cantvacias)
      mover
    juntarFlores(flores,cantvacias)
    Informar("Cantidad de flores ",flores)
    Informar("Cantidad de esquinas vacias ",cantvacias)
  fin
areas
  ciudad: AreaP (1,1,1,100)
robots
  robot robot1
  comenzar
    recorrerAvenida(1)
  fin
variables
  R_info: robot1
comenzar
  AsignarArea(R_info, ciudad)
  Iniciar(R_info, 1,1)
fin